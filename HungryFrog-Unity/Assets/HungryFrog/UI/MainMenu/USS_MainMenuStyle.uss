.header {
    font-size: 40px;
    color: rgb(255, 255, 255);
}

.menubutton {
    font-size: 45%;
    width: 40%;
    height: 15%;
    padding: 0 0;
    align-self: center;
    border-radius: 0;
    background-image: url("project://database/Assets/HungryFrog/Art/UI/SPR_UI_ScorePanel.png?fileID=21300000&guid=94c735b456c8e14449821a602a54a2c1&type=3#SPR_UI_ScorePanel");
    color: rgb(201, 201, 201);
    -unity-background-image-tint-color: rgb(166, 166, 166);
    -unity-slice-scale: 1.1px;
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
    transition-duration: 0.35s;
    min-width: 10px;
    min-height: 100px;
    max-width: 450px;
    max-height: 180px;
    margin-bottom: 2%;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-outline-width: 0;
}

.menubutton:focus {
    font-size: 50%;
    color: rgb(255, 255, 255);
    transition-timing-function: ease;
    -unity-background-image-tint-color: rgb(188, 0, 0);
}
